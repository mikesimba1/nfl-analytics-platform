{
  "name": "NFL Analytics Dev",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "backend",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "forwardPorts": [5000, 3000],
  "waitFor": "onCreateCommand",
  "onCreateCommand": "echo Devcontainer ready",
  "postCreateCommand": "python --version && pip list | findstr fastapi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}


